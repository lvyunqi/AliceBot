{
  "type": "object",
  "fields": {
    "persona": {
      "ui:order": ["name", "gender", "age", "personality", "background", "speaking_style"],
      "name": {
        "ui:placeholder": "输入 AI 名字"
      },
      "personality": {
        "ui:widget": "textarea",
        "ui:placeholder": "如：俏皮、有点毒舌、好奇心强"
      },
      "background": {
        "ui:widget": "textarea",
        "ui:placeholder": "描述背景故事"
      },
      "speaking_style": {
        "ui:widget": "textarea",
        "ui:placeholder": "如：口语化，爱用表情词"
      }
    },
    "llm": {
      "ui:order": ["enabled", "request_timeout_ms", "retry_limit", "providers"],
      "request_timeout_ms": {
        "unit": "毫秒"
      },
      "retry_limit": {
        "unit": "次"
      },
      "providers": {
        "items": {
          "ui:order": ["id", "protocol", "base_url", "model", "api_key", "priority", "enabled"],
          "api_key": {
            "ui:widget": "password",
            "ui:placeholder": "输入 API Key（不回显）"
          },
          "base_url": {
            "ui:placeholder": "https://api.openai.com/v1"
          },
          "model": {
            "ui:placeholder": "gpt-4o-mini"
          }
        }
      }
    },
    "behavior": {
      "ui:order": ["temperature", "max_tokens", "max_context_tokens", "allow_typos", "emoji_usage"],
      "temperature": {
        "ui:widget": "slider",
        "unit": ""
      },
      "emoji_usage": {
        "ui:widget": "slider",
        "unit": ""
      },
      "max_tokens": {
        "unit": "tokens"
      },
      "max_context_tokens": {
        "unit": "tokens"
      }
    },
    "decision": {
      "ui:order": ["enabled", "reply_bias", "min_interval_sec", "coalesce_window_ms", "activity_alpha", "quiet_threshold", "burst_threshold"],
      "reply_bias": {
        "ui:widget": "slider"
      },
      "min_interval_sec": {
        "unit": "秒"
      },
      "coalesce_window_ms": {
        "unit": "毫秒"
      },
      "activity_alpha": {
        "ui:widget": "slider"
      },
      "quiet_threshold": {
        "ui:widget": "slider"
      },
      "burst_threshold": {
        "ui:widget": "slider"
      }
    },
    "memories": {
      "ui:order": ["short_size", "long_topk", "compress_interval_hours", "compress_min_messages", "importance_threshold", "knowledge_enabled", "reflection_enabled", "reflection_interval_hours", "reflection_min_decisions", "reflection_learning_rate", "reflection_target_autonomous_rate"],
      "short_size": {
        "unit": "条"
      },
      "long_topk": {
        "unit": "条"
      },
      "compress_interval_hours": {
        "unit": "小时"
      },
      "compress_min_messages": {
        "unit": "条"
      },
      "reflection_interval_hours": {
        "unit": "小时"
      },
      "reflection_min_decisions": {
        "unit": "条"
      },
      "reflection_learning_rate": {
        "ui:widget": "slider",
        "step": 0.001
      },
      "reflection_target_autonomous_rate": {
        "ui:widget": "slider",
        "step": 0.01
      }
    },
    "stickers": {
      "ui:order": ["enabled", "auto_collect", "collect_probability", "send_probability", "link_enabled", "max_chain"],
      "collect_probability": {
        "ui:widget": "slider",
        "unit": ""
      },
      "send_probability": {
        "ui:widget": "slider",
        "unit": ""
      },
      "max_chain": {
        "unit": "张"
      }
    },
    "send": {
      "ui:order": ["account_id"],
      "account_id": {
        "ui:placeholder": "填写宿主 bots.account_id"
      }
    }
  }
}
