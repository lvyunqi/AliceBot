      },
      "retry_limit": {
        "unit": "次"
      },
      "providers": {
        "items": {
          "ui:order": ["id", "protocol", "base_url", "model", "api_key", "priority", "enabled"],
          "api_key": {
            "ui:widget": "password",
            "ui:placeholder": "输入 API Key（不回显）"
          },
          "base_url": {
            "ui:placeholder": "https://api.openai.com/v1"
          },
          "model": {
            "ui:placeholder": "gpt-4o-mini"
          }
        }
      }
    },
    "behavior": {
      "ui:order": ["reply_bias", "temperature", "max_tokens", "max_context_tokens", "min_interval_sec", "allow_typos", "emoji_usage"],
      "reply_bias": {
        "ui:widget": "slider",
        "unit": ""
      },
      "temperature": {
        "ui:widget": "slider",
        "unit": ""
      },
      "emoji_usage": {
        "ui:widget": "slider",
        "unit": ""
      },
      "max_tokens": {
        "unit": "tokens"
      },
      "max_context_tokens": {
        "unit": "tokens"
      },
      "min_interval_sec": {
        "unit": "秒"
      }
