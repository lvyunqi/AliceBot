{
  "type": "object",
  "fields": {
    "persona": {
      "ui:order": ["name", "gender", "age", "personality", "background", "speaking_style"],
      "name": {
        "ui:placeholder": "输入 AI 名字"
      },
      "personality": {
        "ui:widget": "textarea",
        "ui:placeholder": "如：俏皮、有点毒舌、好奇心强"
      },
      "background": {
        "ui:widget": "textarea",
        "ui:placeholder": "描述背景故事"
      },
      "speaking_style": {
        "ui:widget": "textarea",
        "ui:placeholder": "如：口语化，爱用表情词"
      }
    },
    "llm": {
